# =============================================================================
# React Frontend — Production Dockerfile (Multi-stage)
# =============================================================================
FROM node:20-alpine AS builder

WORKDIR /app

# Install dependencies
COPY films/package*.json ./films/
RUN cd films && npm ci

# Build
COPY films/ ./films/
RUN cd films && npm run build

# Production stage - Nginx
FROM nginx:alpine AS production

# Copy built assets
COPY --from=builder /app/films/build /usr/share/nginx/html

# Nginx config for SPA routing
COPY movies.nginx.conf /etc/nginx/conf.d/default.conf

EXPOSE 80

HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 \
    CMD wget -qO- http://localhost/health || exit 1

CMD ["nginx", "-g", "daemon off;"]